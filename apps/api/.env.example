PORT=4000

# Service-role key — bypasses RLS. Server-side only, never expose to a
# browser bundle. Find both in Supabase project settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs portable credential JWTs (POST /credentials). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
